# The image is built from cmd/, internal/, pkg/ and web/ alone. Everything else
# is kept out of the build context so that a change to it does not rebuild the
# image. A locally built web application is kept out too: the image builds its own.
.git
.github
docs
examples
plugins
testdata
tools
**/node_modules
**/dist
web/e2e
web/test-results
web/playwright-report
