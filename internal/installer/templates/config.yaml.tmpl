# Advisory code review. Generated by `reviewer init` on a repository it inspected
# once; edit freely. Every value here was detected, and a wrong one is a one-line
# fix rather than a bug report against a heuristic (ADR-0020 in adamtait/reviewer).
{{- if .Plugins }}

# Analyzers reach the core over the plugin protocol, first-party ones included, so
# there is one contract to keep working (ADR-0006).
plugins:
{{- range .Plugins }}
  - id: {{ .ID }}
    command: {{ .Command }}
    args: [{{ range $i, $a := .Args }}{{ if $i }}, {{ end }}"{{ $a }}"{{ end }}]
{{- end }}
{{- else }}

# No plugins: nothing TypeScript-shaped was detected here. The analyzers that
# spawn a binary still run.
plugins: []
{{- end }}
{{- if .Projects }}

# The directories this repository divides into. A change confined to one is
# analyzed as one. This is a performance hint: every finding is filtered to the
# changed lines regardless, so narrowing here cannot hide anything (ADR-0007).
projects:
{{- range .Projects }}
  - {{ . }}
{{- end }}
{{- end }}

analyzers:
  # Exceeding this kills the analyzer's process group; the run continues without
  # it and says so, rather than failing the review (ADR-0013).
  timeout: {{ .Timeout }}
  # How much surrounding source a finding carries into the model lane.
  contextLines: {{ .ContextLines }}

rules:
  # This repository's own convention rules. They live here, never in the tool.
  dir: {{ .RulesDir }}

gate:
  # A finding in the "secrets/" namespace, or a scan that could not run at all,
  # stops the model lane before any diff leaves the machine (ADR-0012). These are
  # the analyzers whose success means the diff was actually checked.
  secretsAnalyzers: [{{ range $i, $a := .SecretsAnalyzers }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}]

laneB:
  # Off. Turning the model lane on sends diff excerpts to a model provider, which
  # is a decision for whoever owns this repository, not for an installer.
  enabled: false
{{- if .Provider }}
  provider: {{ .Provider }}
  # The model itself is named by REVIEW_MODEL_NAME in the environment, so that
  # changing it is not a commit. See .env.example.
{{- else }}
  # No access path was chosen at install. Add one with `reviewer init --provider`,
  # or set laneB.provider by hand; see docs/providers.md in adamtait/reviewer.
{{- end }}

github:
  # No endpoint is compiled into the binary (ADR-0004). GitHub Enterprise works by
  # changing this line, not the code.
  apiBaseUrl: https://api.github.com
{{- if .Repo }}
  repo: {{ .Repo }}
{{- else }}
  # No origin remote was detected. Set this to owner/name.
  repo: ""
{{- end }}
  # Resolving a thread is the only action this tool takes on a human's
  # conversation, so it is opt-in.
  resolveStaleThreads: false
