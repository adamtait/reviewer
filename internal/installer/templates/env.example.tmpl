# Variables the reviewer reads from the environment. Copy to .env and fill in, or
# export them another way — nothing here is read from a file by the tool itself.
#
# This file names variables. It never holds a value: `reviewer init` cannot write
# a credential to disk, and a committed .env.example that contained one would be a
# leak in the repository's history rather than in its working tree.

# A token with pull-requests: write, for `reviewer watch` run from this machine.
# The GitHub Action supplies its own and does not read this.
GITHUB_TOKEN=
{{- if .Provider }}

# The model lane, via {{ .Provider }}. These are absent on a fork's pull request,
# which is what skips the lane there (ADR-0018).
{{- range .ProviderEnv }}
{{ . }}=
{{- end }}
{{- if not .ProviderEnv }}
# {{ .Provider }} needs no credential: it drives a CLI already signed in to a
# subscription. Nothing to set here.
{{- end }}
{{- end }}
