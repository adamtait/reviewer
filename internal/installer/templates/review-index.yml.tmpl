# Navigation index for the review workspace. Generated by `reviewer init`; edit freely.
#
# On every push this builds an index of the TypeScript code at the pushed commit
# and saves it as a workflow artifact. The review workspace reads it to offer
# go-to-definition and find-references on a pull request. Nothing else uses it:
# deleting this file turns that navigation off and changes nothing else.
#
# push, not pull_request: a pull request with a merge conflict gets no
# pull_request run at all, and a pull_request run checks out a temporary merge
# rather than the commit a reviewer is looking at — see ADR-0034 in
# adamtait/reviewer.
name: review-index

on:
  push:
    branches: ["**"]

# Read-only, and no secret: the job runs the repository's own install, so it is
# given nothing a pull request could take.
permissions:
  contents: read

jobs:
  index:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      # On a push the default checkout is the pushed commit, which is the commit
      # the index has to describe.
      - uses: actions/checkout@v4
{{- if .NeedsCorepack }}

      # Before setup-node: its cache resolution shells out to the package manager,
      # and neither pnpm nor yarn is on a hosted runner until corepack provides it.
      - run: corepack enable
{{- end }}

      - uses: actions/setup-node@v4
        with:
          node-version: {{ .NodeVersion | yaml }}
{{- if .CacheKey }}
          cache: {{ .CacheKey | yaml }}
{{- end }}
      - run: {{ .InstallCommand | yaml }}

      # Pinned: the workspace's reader is tested against this version's output.
      # It reads tsconfig.json at the repository root and writes index.scip.
      - run: npx --yes @sourcegraph/scip-typescript@{{ .IndexerVersion }} index

      - uses: actions/upload-artifact@v4
        with:
          name: review-index
          path: index.scip
          if-no-files-found: error
