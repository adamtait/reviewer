#!/bin/sh
# Runs this repository's review tool. Generated by `reviewer init`; edit freely.
#
# A wrapper rather than a documented command line, for one reason: an agent reading
# SKILL.md should not have to know which flags this repository needs. Everything
# repository-specific is here, and every argument is passed straight through — this
# script adds no flags of its own, so anything `reviewer --help` documents works.
set -eu

# This script's own location, with symlinks resolved.
#
# `$0` is the path used to reach the script, which is not where it lives: an agent
# runtime that surfaces a skill through a symlink would otherwise make the root
# four levels above the *link*. That reviews some other directory entirely and, if
# it happens to be inside another repository, succeeds and reports nothing found.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done

# The repository root: four levels above .agent/skills/code-review/scripts/.
root=$(cd "$(dirname "$self")/../../../.." && pwd)

if ! command -v reviewer >/dev/null 2>&1; then
  echo "reviewer is not installed or not on PATH." >&2
  echo "Install it with: go install github.com/adamtait/reviewer/cmd/reviewer@latest" >&2
  echo "Or download a release binary: https://github.com/adamtait/reviewer/releases" >&2
  exit 127
fi

# A subcommand has to stay first, because the CLI reads one only at that position.
# Putting --root before it would make every subcommand unreachable through this
# script, which is the opposite of "anything reviewer --help documents works".
case ${1:-} in
  init|watch|version|rules|baseline|metrics)
    subcommand=$1
    shift
    exec reviewer "$subcommand" --root "$root" "$@"
    ;;
esac

exec reviewer --root "$root" "$@"
