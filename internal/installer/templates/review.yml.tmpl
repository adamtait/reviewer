# Advisory code review. Generated by `reviewer init`; edit freely.
#
# pull_request, not pull_request_target: a fork's pull request gets no secrets,
# so the model lane is skipped and the deterministic lane still runs and comments.
# That is the correct degradation, not a limitation to work around — see ADR-0018
# in adamtait/reviewer.
#
# Permissions are per job and the least each needs. The review job reads the
# code and writes comments: contents: read and pull-requests: write, set for the
# whole workflow below. The risk job, commented out at the end, sets its own and
# adds actions: read. Nothing in either can merge, approve, close or push.
name: review

on:
  pull_request:
    # The default three, and ready_for_review, so that the risk job, which skips
    # drafts, runs when a draft is marked ready.
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read
  pull-requests: write

jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # Needed for the merge base. Without it the diff covers the wrong
          # commits, and the action refuses to run rather than guess.
          fetch-depth: 0
{{- if .NeedsNode }}
{{- if .NeedsCorepack }}

      # Before setup-node: its cache resolution shells out to the package manager,
      # and neither pnpm nor yarn is on a hosted runner until corepack provides it.
      - run: corepack enable
{{- end }}

      - uses: actions/setup-node@v4
        with:
          node-version: {{ .NodeVersion | yaml }}
{{- if .CacheKey }}
          cache: {{ .CacheKey | yaml }}
{{- end }}
      - run: {{ .InstallCommand | yaml }}
{{- end }}

      - uses: adamtait/reviewer@v{{ .ReviewerVersion }}
        with:
          version: {{ .ReviewerVersion | yaml }}
          checksum: {{ .ReviewerChecksum | yaml }}
        env:
          GITHUB_TOKEN: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}
{{- if .NeedsModelSecret }}
          # Absent on a fork's pull request, which is what skips the model lane.
          # Set this secret before turning laneB.enabled on in .review/config.yaml.
          REVIEW_MODEL_API_KEY: ${{ "{{" }} secrets.REVIEW_MODEL_API_KEY {{ "}}" }}
{{- end }}
{{- range .ProviderVars }}
          # Configuration, not a credential: set it as a repository variable. The
          # model lane reads it only from here, so without it the lane has a key
          # and nothing to call.
          {{ . }}: ${{ "{{" }} vars.{{ . }} {{ "}}" }}
{{- end }}
{{- if not .ProviderWorksInCI }}
          # The chosen model access path ({{ .Provider }}) drives a CLI signed in to
          # a subscription. A hosted runner has no such session, so the model lane
          # is skipped here and runs only from a machine where you are logged in.
{{- end }}

  # The advisory risk record: one comment and risk/ labels saying where to look
  # first (risk/auth, risk/ci, risk/wide, ...). It never decides or blocks
  # anything, and exits 0 whatever it finds — see ADR-0035 in adamtait/reviewer.
  # Uncomment to turn it on.
  #
  # It reads its rules from the merge base, never from the pull request:
  # .review/risk.yaml, CODEOWNERS, and the index review-index.yml builds on
  # every push, which it needs to say how widely a changed symbol is used
  # (risk/reach). Without that workflow the comment says reach is not available.
  #
  # It runs beside the review, not after it, so it has no `needs:`. actions: read
  # is for downloading the index; this job holds it and the review job does not.
  # Set github.selfLogin: github-actions[bot] in .review/config.yaml so it can
  # remove a label it set that no longer applies; without it, it only adds.
